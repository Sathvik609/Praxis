# Praxis session service on the COOL Graviton instance (installed by remote_setup.sh).
# cv2 comes from COOL via PYTHONPATH / LD_LIBRARY_PATH; the venv has no OpenCV wheel.
[Unit]
Description=Praxis session service (FastAPI + OpenCV 5 COOL)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/praxis/app
Environment=PYTHONPATH=/opt/cool/python_3.12/site-packages
Environment=LD_LIBRARY_PATH=/opt/cool/cpp_sdk/lib
Environment=PRAXIS_CLOUD_ENABLED=1
Environment=PRAXIS_EVAL_DIR=/opt/praxis/app/evaluation/dataset_v0
Environment=PRAXIS_WEB_DIST=/opt/praxis/app/web_dist
Environment=PRAXIS_DB=/opt/praxis/data/praxis.db
Environment=PRAXIS_TRACE_DIR=/opt/praxis/data/traces
Environment=PORT=8000
Environment=PRAXIS_AGENT=off
# Optional: ANTHROPIC_API_KEY and PRAXIS_AGENT=anthropic (deploy.sh --agent), root-only file.
EnvironmentFile=-/etc/praxis/agent.env
ExecStart=/opt/praxis/venv/bin/uvicorn praxis_session.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
