{
  "id": "dim_light",
  "title": "Dim light: markers found but the frame is too dark, and it stays dark",
  "mode": "cup",
  "steps": [
    {
      "frame": {
        "dim": 0.22
      }
    },
    {
      "events": [
        {
          "type": "reach_complete",
          "t": 1,
          "to_dot": 1,
          "from_dot": 0,
          "verified": false,
          "reason": "marker_lost",
          "reach_ms": 940,
          "arc": 1,
          "phase": "slow"
        },
        {
          "type": "reach_complete",
          "t": 2,
          "to_dot": 1,
          "from_dot": 0,
          "verified": false,
          "reason": "marker_lost",
          "reach_ms": 980,
          "arc": 1,
          "phase": "slow"
        },
        {
          "type": "reach_complete",
          "t": 3,
          "to_dot": 1,
          "from_dot": 0,
          "verified": false,
          "reason": "marker_lost",
          "reach_ms": 1020,
          "arc": 1,
          "phase": "slow"
        }
      ]
    },
    {
      "run": {
        "feed": {
          "dim": 0.22
        }
      }
    }
  ],
  "script": {
    "pause": [
      {
        "tool": "get_set_summary"
      },
      {
        "tool": "check_setup"
      },
      {
        "tool": "speak",
        "if": "check_setup.first_hint",
        "args": {
          "text": "{check_setup.first_hint}",
          "cue": "correct",
          "evidence": "$evidence"
        }
      },
      {
        "tool": "speak",
        "if": "check_setup.all_pass",
        "args": {
          "text": "The camera looks fine: after placing the cup, lift your hand clear so I can see the base.",
          "cue": "correct",
          "evidence": "$evidence"
        }
      },
      {
        "tool": "recalibrate"
      },
      {
        "tool": "request_resume",
        "args": {
          "reason": "I re-checked the setup with the camera.",
          "evidence": "$evidence"
        }
      },
      {
        "tool": "speak",
        "if": "request_resume.hint",
        "args": {
          "text": "Still not quite: {request_resume.hint}",
          "cue": "correct",
          "evidence": "$evidence"
        }
      }
    ]
  },
  "expect": {
    "triggers": [
      "pause:failed_reps"
    ],
    "perceive_before": {
      "speak": [
        "check_setup"
      ]
    },
    "speak_mentions": [
      "dark|light"
    ],
    "prompt_kinds": [],
    "resume_blocked": true,
    "paused_at_end": true,
    "stopped": false,
    "errors": []
  }
}
