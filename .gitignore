# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
dist-design/
.vite/
coverage/

# CDK
cdk.out/

# Models (downloaded by script, never committed)
services/session/models/*.onnx

# Recordings and local data (consented clips never committed; tools/record_session.py asks git
# before writing a clip and refuses any path that is not ignored here)
evaluation/dataset_v*/**/*.mp4
evaluation/dataset_v*/**/*.mov
evaluation/dataset_v*/**/*.avi
evaluation/dataset_v*/**/*.mkv
evaluation/dataset_v*/**/*.webm
evaluation/dataset_v*/**/*.m4v
evaluation/dataset_v*/**/*.jpg
evaluation/dataset_v*/**/*.png
!evaluation/dataset_v0/synthetic_*.mp4
# Failure-case frames (pixels from consented real clips): local only, deleted with the clip
evaluation/failure_cases/*
!evaluation/failure_cases/README.md
services/session/praxis.db
services/session/data/

# OS / editors
.DS_Store
.idea/
.vscode/
*.log

# local store (edge mode)
services/session/praxis.db
services/session/*.db

# per-session decision traces (kept locally; sample traces are added deliberately)
traces/*.jsonl

# built web app served by the session service (container only)
services/session/web_dist/
services/session/data/
web/*.tsbuildinfo

# Public rehab motion datasets (downloaded by services/session/tools/fetch_rehab_datasets.py, never committed)
evaluation/external/

# Blender working file (regenerated by web/blender/build_avatar.py)
web/blender/*.blend
web/blender/*.blend1

# Secrets (API keys live in .env files; never commit them)
.env
.env.*
!.env.example

# designers artifact snapshots (large built bundles), see docs/design-handoff/
.design-handoff/

# Fake-camera videos for web/scripts/e2e-fake-camera.mjs (regenerated by services/session/tools/make_fake_camera.py)
evaluation/fake_camera/
