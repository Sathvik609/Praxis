# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.
# Run the service with it:  uv run uvicorn praxis_session.main:app --port 8000 --env-file .env
# (python-dotenv ships with uvicorn[standard]; the service never prints these values.)

# Which coach runs: off (rule coach only, default) | anthropic (Claude via the Anthropic API) | scripted (no key, canned tool calls)
PRAXIS_AGENT=off

# Anthropic API key for the Claude agent coach (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Model for the agent (default Claude Sonnet 5.5; claude-haiku-5-5 is the measured low-cost option, see docs/AGENT.md)
PRAXIS_AGENT_MODEL=claude-sonnet-5-5

# Agent runs per UTC day across all sessions (spend cap; 0 = unlimited; a restart resets the count)
PRAXIS_AGENT_DAILY_RUNS=100

# Where the agent reaches this service's MCP routes (default http://127.0.0.1:$PORT/mcp, PORT=8000)
# PRAXIS_MCP_URL=http://127.0.0.1:8000/mcp
