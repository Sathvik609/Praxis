{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Praxis event",
  "type": "object",
  "required": [
    "type",
    "t",
    "id"
  ],
  "properties": {
    "type": {
      "enum": [
        "heartbeat",
        "error",
        "calibration",
        "quality",
        "setup_checks",
        "perception_lost",
        "perception_regained",
        "frame",
        "exercise_start",
        "state_change",
        "rep_complete",
        "wrong_hole",
        "drop",
        "nhpt_start",
        "nhpt_split",
        "nhpt_complete",
        "reach_complete",
        "wrong_dot",
        "arc_complete",
        "cup_complete",
        "command",
        "target_missed",
        "hold_too_short",
        "compensation_lean",
        "shoulder_hiking",
        "set_complete",
        "arm_complete",
        "coach",
        "speak",
        "stop",
        "pause",
        "resume",
        "rest",
        "therapist_flag",
        "exertion",
        "replay_start",
        "replay_end",
        "self_report",
        "agent_status",
        "session_start"
      ]
    },
    "t": {
      "type": "number"
    },
    "id": {
      "type": "integer"
    },
    "frame_index": {
      "type": "integer"
    },
    "frame": {
      "type": "object",
      "required": [
        "width",
        "height",
        "bytes"
      ]
    },
    "code": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "calibrated": {
      "type": "boolean"
    },
    "missing": {
      "type": "array"
    },
    "source": {
      "enum": [
        "fresh",
        "held",
        "partial",
        "self_ticked",
        "coach",
        "rule",
        "agent",
        null
      ],
      "description": "calibration: where the homography came from (fresh | partial | held | null). self_report: always 'self_ticked' (the patient's own tick on a demo-only exercise, never a camera-verified rep). command: 'coach' when a coach decision (a regress's set_hold) asked for it rather than the client. coach: 'rule' (deterministic rule coach) or 'agent' (Claude agent, 29 Sep). command: 'agent' when the patient accepted an agent prompt (resume, set_target, set_hold, set_reps, set_phase) or the agent ran recalibrate."
    },
    "age_s": {
      "type": "number"
    },
    "tilt_deg": {
      "type": [
        "number",
        "null"
      ]
    },
    "rms_mm": {
      "type": [
        "number",
        "null"
      ]
    },
    "markers_px": {
      "type": "object"
    },
    "targets_px": {
      "type": "array"
    },
    "lighting": {
      "type": "object"
    },
    "steadiness": {
      "type": "object"
    },
    "presence": {
      "type": "object"
    },
    "angle": {
      "type": "object"
    },
    "all_required_pass": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "label"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "check",
              "fail",
              "pending"
            ]
          }
        }
      }
    },
    "nhpt": {
      "type": "object"
    },
    "board": {
      "type": "object"
    },
    "overlay": {
      "type": "object"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "rep": {
      "type": "integer"
    },
    "hole": {
      "type": [
        "integer",
        "null"
      ]
    },
    "target": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_s": {
      "type": "number"
    },
    "peg": {
      "type": "integer"
    },
    "split_s": {
      "type": "number"
    },
    "elapsed_s": {
      "type": "number"
    },
    "total_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "splits_s": {
      "type": "array"
    },
    "pegs": {
      "type": "array"
    },
    "free_pegs_mm": {
      "type": "array"
    },
    "hand": {
      "type": "object"
    },
    "models": {
      "type": "object"
    },
    "proc_ms": {
      "type": "number"
    },
    "t_capture": {
      "description": "Browser capture time of the frame this event answers, ms since the Unix epoch (performance.timeOrigin + performance.now()), sent as an 8-byte little-endian float64 prefix on the JPEG. null when the frame carried no prefix (bare JPEG, replay).",
      "type": [
        "number",
        "null"
      ]
    },
    "dropped": {
      "description": "Frames that arrived while this one was queued and were discarded oldest-first (frame_index still counts every received frame, so gaps show drops).",
      "type": "integer",
      "minimum": 0
    },
    "latency": {
      "description": "Wall-clock timings on the service. On frame/heartbeat: capture_to_event_ms (null without t_capture; browser clock vs service clock, skew included when they differ) and proc_ms (pipeline time in the executor). On coach: event_to_cue_ms (perception events returned -> cue sent) and capture_to_cue_ms.",
      "type": "object",
      "properties": {
        "capture_to_event_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "proc_ms": {
          "type": "number"
        },
        "event_to_cue_ms": {
          "type": "number"
        },
        "capture_to_cue_ms": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cup": {
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "from_dot": {
      "type": "integer"
    },
    "to_dot": {
      "type": "integer"
    },
    "reach_ms": {
      "type": "number"
    },
    "verified": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "arc": {
      "type": "integer"
    },
    "dot": {
      "type": [
        "integer",
        "null"
      ]
    },
    "expected": {
      "type": "integer"
    },
    "arcs": {
      "type": "integer"
    },
    "reaches": {
      "type": "array"
    },
    "mean_reach_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "unverified": {
      "type": "integer"
    },
    "awaiting_phase": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "arm": {
      "type": "object"
    },
    "pose": {
      "type": "object"
    },
    "set": {
      "type": "integer"
    },
    "peak_deg": {
      "type": "number"
    },
    "hold_s": {
      "type": "number"
    },
    "held_s": {
      "type": "number"
    },
    "target_deg": {
      "type": "number"
    },
    "lean_deg": {
      "type": "number"
    },
    "count": {
      "type": "integer"
    },
    "flagged": {
      "type": "boolean"
    },
    "hike": {
      "type": [
        "number",
        "boolean"
      ]
    },
    "sets": {
      "type": "integer"
    },
    "lean": {
      "type": "boolean"
    },
    "t_start": {
      "type": "number"
    },
    "t_end": {
      "type": "number"
    },
    "session_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "cue_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "ui": {
      "type": "object"
    },
    "label": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array"
    },
    "speak_id": {
      "type": "integer"
    },
    "detail": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "reasons": {
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "pain": {
      "type": "integer"
    },
    "summary": {
      "description": "command (cmd feedback) ack: CoachSession.summary(), also stored as the session's summary_json (GET /api/sessions/{id}). Only the fields below are constrained; the rest are free.",
      "type": "object",
      "properties": {
        "camera": {
          "description": "OpenCV counts and measures for the session.",
          "type": "object",
          "properties": {
            "posture_cues": {
              "description": "lean_cues + hiking_cues.",
              "type": "integer",
              "minimum": 0
            },
            "lean_cues": {
              "description": "compensation_lean events seen (6 Oct).",
              "type": "integer",
              "minimum": 0
            },
            "hiking_cues": {
              "description": "shoulder_hiking events seen (6 Oct).",
              "type": "integer",
              "minimum": 0
            },
            "wrong_dot": {
              "description": "Waiter - cup: wrong_dot events from the cup FSM (cup placed on a dot that was not next) (6 Oct).",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "told_us": {
          "description": "What the patient told us: the check-in (pain_before, energy, minutes, new_symptoms) then the feedback form, merged; Edit feedback (PATCH /api/sessions/{id}/feedback) merges again. Every feedback key is optional (the form can be skipped).",
          "type": "object",
          "properties": {
            "pain_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "pain_after": {
              "description": "Pain right after the session, 0-10. At or above the prescription's stop level (pain_max) it writes a pain_after therapist flag (no stop).",
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "effort": {
              "description": "Effort 0-10; the 6 Oct form maps difficulty to it (too_easy 2, just_right 4, hard 7, couldnt_finish 9).",
              "type": [
                "integer",
                "null"
              ]
            },
            "difficulty": {
              "description": "How hard was that? too_easy | just_right | hard | couldnt_finish (6 Oct form).",
              "type": "string"
            },
            "again_tomorrow": {
              "description": "Could you do this again tomorrow? yes_easily | yes_probably | not_sure | no (6 Oct form).",
              "type": "string"
            },
            "barriers": {
              "description": "What got in the way (only when the session ended early): tired, pain, weak, unsteady, camera, time, interrupted, equipment.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ended_early": {
              "description": "The session ended before the planned dose (the form shows the barriers step).",
              "type": "boolean"
            },
            "end_reason": {
              "description": "Why the session ended early, when the client knows (free text or a stop rule id).",
              "type": "string"
            },
            "compared": {
              "description": "Pre-6-Oct form: compared with last time.",
              "type": "string"
            },
            "detail": {
              "description": "Pre-6-Oct form: the patient's free-text note.",
              "type": "string"
            }
          }
        },
        "coach": {
          "type": "object",
          "properties": {
            "notes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cat": {
                    "description": "Report category (6 Oct): rest/stop -> Safety; a correction for trunk lean or shoulder hiking -> Posture; a correction for an unverified rep -> Data quality; progress, regress and other corrections -> Performance.",
                    "enum": [
                      "Performance",
                      "Posture",
                      "Safety",
                      "Data quality"
                    ]
                  },
                  "confidence": {
                    "enum": [
                      "high",
                      "medium"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "text",
                  "confidence",
                  "evidence",
                  "cat"
                ]
              }
            }
          }
        },
        "flags": {
          "description": "Therapist flags written this session (stop rules, plus pain_after from the feedback form).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "rule",
              "detail"
            ],
            "properties": {
              "rule": {
                "description": "pain | symptoms | lean | failed_reps | missed_reps | exertion | pain_after (post-session pain at or above the stop level; a flag only, never a stop).",
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "t": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "cmd": {
      "type": [
        "string",
        "null"
      ]
    },
    "clip": {
      "type": "string"
    },
    "fps": {
      "type": "number"
    },
    "frames": {
      "type": "integer"
    },
    "mode": {
      "type": "string"
    },
    "colour": {
      "description": "Sampled HSV window (sample_colour reply): h, s, v medians, h_lo/h_hi (OpenCV 0-180, may wrap), s_min, v_min, skin_excluded, source.",
      "type": [
        "object",
        "null"
      ]
    },
    "at_mm": {
      "type": "array"
    },
    "grasp": {
      "description": "state_change to grasped: what lifted the peg - 'count' (a free peg disappeared) or 'pinch' (pinch aperture in the source zone).",
      "enum": [
        "count",
        "pinch"
      ]
    },
    "exercise": {
      "description": "Arm-FSM exercise id from perception/exercises.py (pendulum, flexion, abduction); on self_report a demo-only id (external_rotation, internal_rotation).",
      "type": "string"
    },
    "name": {
      "description": "Human name of the exercise (exercise_start).",
      "type": "string"
    },
    "view": {
      "description": "Camera view the exercise is scored from; the FSM freezes in the other one.",
      "enum": [
        "side",
        "front"
      ]
    },
    "kind": {
      "description": "Rep shape: hold (lift, hold, lower) or oscillation (pendulum swings).",
      "enum": [
        "hold",
        "oscillation"
      ]
    },
    "tier": {
      "description": "Pain tier applied to the dose: full or gentle.",
      "enum": [
        "full",
        "gentle"
      ]
    },
    "dose": {
      "description": "Prescribed dose as shown to the patient, e.g. '2 x 8 - hold 3 s'.",
      "type": "string"
    },
    "reps": {
      "description": "Reps in the set (set_complete) or per set (exercise_start).",
      "type": "integer"
    },
    "swing_deg": {
      "description": "Pendulum rep: peak-to-peak swing amplitude in camera-relative degrees. Approximation, validated on synthetic landmarks only.",
      "type": "number"
    },
    "verified_reps": {
      "description": "set_complete: reps in the set the camera verified.",
      "type": "integer"
    },
    "best_deg": {
      "description": "set_complete: best verified angle in the set, camera-relative degrees.",
      "type": "number"
    },
    "state": {
      "type": "string",
      "description": "agent_status: thinking | idle | offline."
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ],
      "description": "agent_status: the checkpoint that started the run (checkin, set_complete, arc_complete, pause:failed_reps, pause:perception, nhpt_complete, feedback)."
    }
  }
}
