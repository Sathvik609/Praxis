{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Praxis event",
  "type": "object",
  "required": [
    "type",
    "t",
    "id"
  ],
  "properties": {
    "type": {
      "enum": [
        "heartbeat",
        "error",
        "calibration",
        "quality",
        "setup_checks",
        "perception_lost",
        "perception_regained",
        "frame",
        "state_change",
        "rep_complete",
        "wrong_hole",
        "drop",
        "nhpt_start",
        "nhpt_split",
        "nhpt_complete",
        "reach_complete",
        "wrong_dot",
        "arc_complete",
        "cup_complete",
        "command",
        "target_missed",
        "hold_too_short",
        "compensation_lean",
        "shoulder_hiking",
        "set_complete",
        "arm_complete",
        "coach",
        "speak",
        "stop",
        "pause",
        "resume",
        "rest",
        "therapist_flag",
        "exertion",
        "replay_start",
        "replay_end"
      ]
    },
    "t": {
      "type": "number"
    },
    "id": {
      "type": "integer"
    },
    "frame_index": {
      "type": "integer"
    },
    "frame": {
      "type": "object",
      "required": [
        "width",
        "height",
        "bytes"
      ]
    },
    "code": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "calibrated": {
      "type": "boolean"
    },
    "missing": {
      "type": "array"
    },
    "rms_mm": {
      "type": [
        "number",
        "null"
      ]
    },
    "markers_px": {
      "type": "object"
    },
    "targets_px": {
      "type": "array"
    },
    "lighting": {
      "type": "object"
    },
    "steadiness": {
      "type": "object"
    },
    "presence": {
      "type": "object"
    },
    "all_required_pass": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "label"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "check",
              "fail",
              "pending"
            ]
          }
        }
      }
    },
    "nhpt": {
      "type": "object"
    },
    "board": {
      "type": "object"
    },
    "overlay": {
      "type": "object"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "rep": {
      "type": "integer"
    },
    "hole": {
      "type": [
        "integer",
        "null"
      ]
    },
    "target": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_s": {
      "type": "number"
    },
    "peg": {
      "type": "integer"
    },
    "split_s": {
      "type": "number"
    },
    "elapsed_s": {
      "type": "number"
    },
    "total_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "splits_s": {
      "type": "array"
    },
    "pegs": {
      "type": "array"
    },
    "free_pegs_mm": {
      "type": "array"
    },
    "hand": {
      "type": "object"
    },
    "models": {
      "type": "object"
    },
    "proc_ms": {
      "type": "number"
    },
    "cup": {
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "from_dot": {
      "type": "integer"
    },
    "to_dot": {
      "type": "integer"
    },
    "reach_ms": {
      "type": "number"
    },
    "verified": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "arc": {
      "type": "integer"
    },
    "dot": {
      "type": [
        "integer",
        "null"
      ]
    },
    "expected": {
      "type": "integer"
    },
    "arcs": {
      "type": "integer"
    },
    "reaches": {
      "type": "array"
    },
    "mean_reach_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "unverified": {
      "type": "integer"
    },
    "awaiting_phase": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "arm": {
      "type": "object"
    },
    "pose": {
      "type": "object"
    },
    "set": {
      "type": "integer"
    },
    "peak_deg": {
      "type": "number"
    },
    "hold_s": {
      "type": "number"
    },
    "held_s": {
      "type": "number"
    },
    "target_deg": {
      "type": "number"
    },
    "lean_deg": {
      "type": "number"
    },
    "count": {
      "type": "integer"
    },
    "flagged": {
      "type": "boolean"
    },
    "hike": {
      "type": [
        "number",
        "boolean"
      ]
    },
    "sets": {
      "type": "integer"
    },
    "lean": {
      "type": "boolean"
    },
    "t_start": {
      "type": "number"
    },
    "t_end": {
      "type": "number"
    },
    "session_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "cue_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "ui": {
      "type": "object"
    },
    "label": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array"
    },
    "speak_id": {
      "type": "integer"
    },
    "detail": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "reasons": {
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "pain": {
      "type": "integer"
    },
    "summary": {
      "type": "object"
    },
    "cmd": {
      "type": [
        "string",
        "null"
      ]
    },
    "clip": {
      "type": "string"
    },
    "fps": {
      "type": "number"
    },
    "frames": {
      "type": "integer"
    }
  }
}
